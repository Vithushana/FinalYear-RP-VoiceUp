# Environment variables for Voice Up Project
# Copy this file to .env and fill in your actual values

# Groq API Key for text abuse detection (DistilBERT)
model_auth_key=your-groq-api-key-here

# Twilio credentials for OTP SMS
ACCOUNT_SID=your-twilio-account-sid
AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# OTP Mock Mode (set to 'true' to print OTP to console instead of sending SMS)
OTP_MOCK_MODE=true

# Flask Secret Keys (change in production!)
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
